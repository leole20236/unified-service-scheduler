    TECHNICIAN ||--o{ RESOURCE_RESERVATION : "bay XOR tech"

    APPOINTMENT {
        uuid id PK "UUIDv7"
        uuid dealership_id FK
        uuid customer_id FK
        uuid vehicle_id FK
        uuid service_bay_id FK
        uuid technician_id FK
        timestamptz start_at "UTC"
        timestamptz end_at "UTC"
        text status
        bigint version
    }
    RESOURCE_RESERVATION {
        uuid id PK
        uuid dealership_id
        uuid service_bay_id FK "XOR"
        uuid technician_id FK "XOR"
        uuid resource_id "generated"
        timestamptz start_at "UTC"
        timestamptz end_at "UTC"
        tstzrange period "generated, EXCLUDE"
        boolean active
    }
